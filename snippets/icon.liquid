    {%- when 'pinterest' -%}<circle cx="12" cy="12" r="9"/><path d="M10.5 9.5c0-2 3.5-2.7 4.5-.5 1 2.3-.5 5.5-2.5 5.5-1.3 0-1.8-1-1.5-2M11.5 12l-2 9"/>
    {%- when 'youtube' -%}<rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/><path d="M10 9v6l5-3z"/>
    {%- when 'twitter' -%}<path d="M4 4l16 16M20 4L4 20" stroke-width="1.6"/>
    {%- else -%}<circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
{%- endcapture -%}
<svg class="icon icon-{{ icon }}{% if class %} {{ class }}{% endif %}" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="{% if icon == 'star' or icon == 'play' %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">{{ path }}</svg>
