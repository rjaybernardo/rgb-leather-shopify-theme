{% doc %}
  Renders star rating from the standard reviews.rating metafield.

  @param {product} product - Product object
  @param {boolean} [show_count] - Show review count

  @example
  {% render 'rating', product: product, show_count: true %}
{% enddoc %}
{%- assign rating = product.metafields.reviews.rating.value -%}
{%- if rating != blank -%}
  {%- assign count = product.metafields.reviews.rating_count -%}
  <span class="rating">
    <span class="rating__stars" style="--rating: {{ rating.rating }}; --rating-max: {{ rating.scale_max }};" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating.rating, rating_max: rating.scale_max }}"></span>
    <span>{{ rating.rating | round: 1 }}</span>
    {%- if show_count and count -%}
      <span>({{ count }})</span>
    {%- endif -%}
  </span>
{%- endif -%}
