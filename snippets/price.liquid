{% doc %}
  Renders product or variant price with compare-at, unit price and optional savings tag.

  @param {product} product - Product object
  @param {variant} [variant] - Variant to price; defaults to selected or first available
  @param {boolean} [show_save] - Show savings tag
  @param {boolean} [large] - Larger price style
  @param {boolean} [use_variant] - Price the variant instead of the product range

  @example
  {% render 'price', product: product, use_variant: true, show_save: true %}
{% enddoc %}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  if use_variant
    assign price = target.price
    assign compare = target.compare_at_price
    assign varies = false
  else
    assign price = product.price
    assign compare = product.compare_at_price
    assign varies = product.price_varies
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--on-sale{% endif %}{% if large %} price--large{% endif %}">
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
  {%- endif -%}
  <span class="price__current">
    {%- if varies -%}
      {%- assign price_money = price | money -%}
      {{ 'products.product.from_price' | t: price: price_money }}
    {%- else -%}
      {{ price | money }}
    {%- endif -%}
  </span>
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
    <s class="price__compare">{{ compare | money }}</s>
    {%- if show_save -%}
      {%- assign saving = compare | minus: price | times: 100.0 | divided_by: compare | round -%}
      <span class="price__save">{{ 'products.product.save_percent' | t: percent: saving }}</span>
    {%- endif -%}
  {%- endif -%}
  {%- if use_variant and target.unit_price_measurement -%}
    <span class="price__unit">
      {{- target.unit_price | money }}/
      {%- if target.unit_price_measurement.reference_value != 1 -%}{{ target.unit_price_measurement.reference_value }}{%- endif -%}
      {{ target.unit_price_measurement.reference_unit -}}
    </span>
  {%- endif -%}
</div>
