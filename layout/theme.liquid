<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_schemes['scheme-1'].settings.background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags.first }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- unless settings.type_body_font.system? -%}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2' }}
    {%- endunless -%}
    {%- unless settings.type_heading_font.system? -%}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2' }}
    {%- endunless -%}

    {% render 'theme-styles' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        settings: {
          cartType: {{ settings.cart_type | json }},
          moneyFormat: {{ shop.money_format | json }},
          freeShippingThreshold: {{ settings.cart_free_shipping_threshold | default: 0 | times: 100 | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          cartError: {{ 'cart.general.error' | t | json }},
          copied: {{ 'general.share.copied' | t | json }},
          deliveryEstimate: {{ 'products.product.delivery_estimate' | t | json }}
        }
      };
    </script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}{% if settings.animations_reveal %} has-reveal{% endif %}{% if settings.animations_hover %} has-hover-zoom{% endif %}{% if settings.label_uppercase %} labels-upper{% endif %}{% if settings.heading_uppercase %} headings-upper{% endif %}{% if settings.button_hover_fill %} btn-fill{% endif %}">
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <quick-view-modal class="modal" id="QuickView" hidden>
      <div class="modal__overlay" data-close></div>
      <div class="modal__panel color-scheme-2" role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_view' | t }}" tabindex="-1">
        <button type="button" class="modal__close icon-button" data-close aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
        <div class="modal__content" data-quick-view-content></div>
      </div>
    </quick-view-modal>

    <div class="toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>
