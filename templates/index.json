        },
        "b1": {
          "type": "heading",
          "settings": {
            "heading": "Three decades at the <em>workbench</em>"
          }
        },
        "b2": {
          "type": "text",
          "settings": {
            "text": "<p>Ricardo G. Bernardo has been making things from leather for more than 30 years. A breeder of game fowl himself, he made his first leather tari case for a Bacolod farm owner and delivered it by hand. That case started a new chapter for the family workshop.</p>"
          }
        },
