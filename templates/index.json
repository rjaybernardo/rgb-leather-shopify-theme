    "why": {
      "type": "multicolumn",
      "settings": {
        "color_scheme": "scheme-2",
        "subheading": "Why genuine leather",
        "heading": "Built to be <em>passed down</em>"
      },
      "blocks": {
        "b0": {
          "type": "column",
          "settings": {
            "icon": "leather",
            "title": "Real leather",
            "text": "<p>Like a fine wine, real leather only gets better with age. It is less likely to tear or crack than synthetics.</p>"
          }
        },
        "b1": {
          "type": "column",
          "settings": {
            "icon": "hand",
            "title": "Hand-tooled",
            "text": "<p>Every pattern is carved and stamped by hand, so no two cases are exactly alike.</p>"
          }
        },
        "b2": {
          "type": "column",
          "settings": {
            "icon": "shield",
            "title": "Made to last",
            "text": "<p>Well-cared-for leather lasts 10 to 15 years or more, long enough to hand down.</p>"
          }
        },
        "b3": {
          "type": "column",
          "settings": {
            "icon": "leaf",
            "title": "Made in the Philippines",
            "text": "<p>Designed and made in our family workshop in Los Baños, Laguna.</p>"
          }
        }
      },
      "block_order": [
        "b0",
        "b1",
        "b2",
        "b3"
      ]
    },
    "faq": {
      "type": "faq",
      "settings": {
        "button_label": "Contact us",
        "button_link": "shopify://pages/contact"
      },
      "blocks": {
        "b0": {
          "type": "question",
          "settings": {
            "question": "How much is delivery?",
            "answer": "<p>We ship nationwide via LBC. Delivery fees are calculated at checkout based on your address.</p>"
          }
        },
        "b1": {
          "type": "question",
          "settings": {
            "question": "Can I order a custom design?",
            "answer": "<p>Yes. Most of our tari cases are made to order, and we can tool your gamefarm name, initials or logo into the leather. Message us with your idea and we'll quote it.</p>"
          }
        },
        "b2": {
          "type": "question",
          "settings": {
            "question": "How long does a made-to-order piece take?",
            "answer": "<p>Lead time depends on the design and our current queue. We'll confirm the timeline before you pay.</p>"
          }
        },
        "b3": {
          "type": "question",
          "settings": {
            "question": "How do I care for my leather?",
            "answer": "<p>Wipe with a dry cloth, keep it out of the rain and direct sun, and condition the leather every few months. Real leather darkens and develops character as it ages.</p>"
          }
        }
      },
      "block_order": [
        "b0",
        "b1",
        "b2",
        "b3"
