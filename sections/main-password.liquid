{%- assign s = section.settings -%}
<div class="password color-{{ s.color_scheme }}" style="position: relative; overflow: hidden;">
  {%- if s.image -%}
    <div class="hero__media">{{ s.image | image_url: width: 2400 | image_tag: widths: '800,1200,1800,2400', sizes: '100vw', alt: '' }}</div>
    <div class="hero__overlay hero__overlay--flat" style="--overlay: .55;"></div>
  {%- endif -%}
  <div class="password__box" style="position: relative; z-index: 1;{% if s.image %} color: #fff;{% endif %}">
    {%- if settings.logo -%}
      {{ settings.logo | image_url: width: 400 | image_tag: style: 'width: 160px; margin: 0 auto 2rem;', alt: shop.name }}
    {%- else -%}
      <p class="h3">{{ shop.name }}</p>
    {%- endif -%}
    <h1 class="h1 heading-italic">{{ s.heading }}</h1>
    {%- if shop.password_message != blank -%}<p style="opacity: .85;">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'templates.password.subscribed' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="newsletter__form" style="margin-top: 1.5rem;">
          <input class="input" type="email" name="contact[email]" required placeholder="{{ 'newsletter.email_placeholder' | t }}" aria-label="{{ 'newsletter.email_placeholder' | t }}">
          <button type="submit" class="btn">{{ 'templates.password.notify' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details style="margin-top: 2.5rem;">
      <summary class="link" style="cursor: pointer;">{{ 'templates.password.enter_using_password' | t }}</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" style="margin-top: 1rem;">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="newsletter__form" style="margin-top: 1rem;">
          <input class="input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'templates.password.password' | t }}" aria-label="{{ 'templates.password.password' | t }}">
          <button type="submit" class="btn">{{ 'templates.password.enter' | t }}</button>
        </div>
      {%- endform -%}
      <p style="font-size: .8rem; opacity: .7; margin-top: 1rem;">{{ 'templates.password.admin_link_html' | t }}</p>
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Something <em>beautiful</em> is coming" }
  ]
}
{% endschema %}
