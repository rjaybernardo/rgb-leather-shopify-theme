{%- assign s = section.settings -%}
<div class="section color-{{ s.color_scheme }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;">
  <div class="page-width">
    <shop-the-look class="lookbook">
      <div class="lookbook__image reveal">
        <div class="media" style="--ratio: 4/5; aspect-ratio: 4/5;">
          {%- if s.image -%}
            {{ s.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600,900,1200,1500,1800', sizes: '(min-width: 990px) 58vw, 100vw', alt: s.image.alt }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          <div class="hotspot" style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;" {{ block.shopify_attributes }}>
            <button type="button" class="hotspot__btn" aria-expanded="false" aria-label="{{ p.title | default: 'Product' | escape }}">{% render 'icon', icon: 'plus' %}</button>
            {%- if p != blank -%}
              <a href="{{ p.url }}" class="hotspot__card">
                <span class="media">{{ p.featured_media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}</span>
                <span><span class="hotspot__card-title" style="display: block;">{{ p.title }}</span>{% render 'price', product: p %}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <div class="reveal" style="--i: 1;">
        {% render 'section-heading', settings: s %}
        <div class="lookbook__products">
          {%- for block in section.blocks -%}
            {%- assign p = block.settings.product -%}
            {%- if p != blank -%}
              <div class="lookbook__product">
                <a href="{{ p.url }}" class="media" tabindex="-1">{{ p.featured_media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}</a>
                <div>
                  <a href="{{ p.url }}" class="lookbook__product-title">{{ p.title }}</a>
                  {% render 'price', product: p %}
                </div>
                {%- if p.available -%}
                  <button type="button" class="icon-button" style="border: 1px solid var(--color-border);" data-quick-add {% if p.has_only_default_variant %}data-variant-id="{{ p.selected_or_first_available_variant.id }}"{% else %}data-product-url="{{ p.url }}"{% endif %} aria-label="{{ 'products.product.quick_add_named' | t: title: p.title | escape }}">{% render 'icon', icon: 'plus' %}</button>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if s.button_label != blank -%}
          <div style="margin-top: 1.5rem;"><a href="{{ s.button_link }}" class="btn">{{ s.button_label }}</a></div>
        {%- endif -%}
      </div>
    </shop-the-look>
  </div>
</div>

{% schema %}
{
  "name": "Shop the look",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Lifestyle image" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Shop the look" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The <em>commuter</em> edit" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Everything you need for the daily carry, tap the dots to explore.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "limit": 6,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "x", "label": "Horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 40 },
        { "type": "range", "id": "y", "label": "Vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the look",
      "blocks": [
        { "type": "hotspot", "settings": { "x": 35, "y": 40 } },
        { "type": "hotspot", "settings": { "x": 62, "y": 65 } },
        { "type": "hotspot", "settings": { "x": 48, "y": 82 } }
      ]
    }
  ]
}
{% endschema %}
