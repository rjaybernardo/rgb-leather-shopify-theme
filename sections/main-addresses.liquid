<div class="section color-{{ section.settings.color_scheme }}" style="--pt: 64px; --pb: 96px;">
  <div class="page-width">
    <a href="{{ routes.account_url }}" class="link">{% render 'icon', icon: 'chevron-left' %} {{ 'customer.account.return' | t }}</a>
    <h1 class="h2 heading-italic" style="margin-top: 1rem;">{{ 'customer.addresses.title' | t }}</h1>
    <div class="account-dashboard">
      <div class="grid" style="--cols: 2; --cols-mobile: 1; align-content: start;">
        {%- paginate customer.addresses by 10 -%}
          {%- for address in customer.addresses -%}
            <div class="address-card">
              {%- if address == customer.default_address -%}<span class="badge" style="margin-bottom: .75rem;">{{ 'customer.addresses.default' | t }}</span>{%- endif -%}
              {{ address | format_address }}
              <details style="margin-top: 1rem;">
                <summary class="link">{{ 'customer.addresses.edit' | t }}</summary>
                {%- form 'customer_address', address -%}
                  {% render 'address-fields', form: form %}
                  <label class="checkbox" style="margin-bottom: 1rem;">{{ form.set_as_default_checkbox }}<span>{{ 'customer.addresses.set_default' | t }}</span></label>
                  <button type="submit" class="btn btn--sm">{{ 'customer.addresses.update' | t }}</button>
                {%- endform -%}
              </details>
              <form method="post" action="{{ address.url }}" style="margin-top: .5rem;"><input type="hidden" name="_method" value="delete"><button type="submit" class="cart-item__remove" onclick="return confirm('{{ 'customer.addresses.delete_confirm' | t | escape }}')">{{ 'customer.addresses.delete' | t }}</button></form>
            </div>
          {%- endfor -%}
          {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
        {%- endpaginate -%}
      </div>
      <aside>
        <h2 class="h4">{{ 'customer.addresses.add' | t }}</h2>
        {%- form 'customer_address', customer.new_address -%}
          {% render 'address-fields', form: form %}
          <label class="checkbox" style="margin-bottom: 1rem;">{{ form.set_as_default_checkbox }}<span>{{ 'customer.addresses.set_default' | t }}</span></label>
          <button type="submit" class="btn btn--full">{{ 'customer.addresses.add' | t }}</button>
        {%- endform -%}
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer addresses",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
