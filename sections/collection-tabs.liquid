{%- assign s = section.settings -%}
<div class="section color-{{ s.color_scheme }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;">
  <div class="page-width">
    {% render 'section-heading', settings: s, align: 'center' %}
    <tabs-component>
      <div class="tabs__list" role="tablist" style="--tabs-align: center;">
        {%- for block in section.blocks -%}
          <button type="button" class="tabs__tab" role="tab" id="Tab-{{ block.id }}" aria-controls="Panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" {{ block.shopify_attributes }}>
            {{- block.settings.title | default: block.settings.collection.title | default: 'Tab' -}}
          </button>
        {%- endfor -%}
      </div>
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <div class="tabs__panel" role="tabpanel" id="Panel-{{ block.id }}" aria-labelledby="Tab-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
          <ul class="grid" role="list" style="--cols: {{ s.columns }}; list-style: none; padding: 0; margin: 0;">
            {%- if c != blank -%}
              {%- for product in c.products limit: s.limit -%}
                <li>{% render 'product-card', product: product, index: forloop.index0 %}</li>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                <li><div class="card"><div class="card__media"><div class="media media--portrait">{{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}</div></div><div class="card__info"><h3 class="card__title">{{ 'sections.featured_collection.placeholder_title' | t }}</h3></div></div></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
          {%- if c != blank -%}
            <div class="section-footer"><a href="{{ c.url }}" class="btn btn--secondary">{{ 'sections.collection_tabs.view_all' | t: title: c.title }}</a></div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </tabs-component>
  </div>
</div>

{% schema %}
{
  "name": "Collection tabs",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Shop the edit" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Something for <em>every</em> day" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Tab label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tabs",
      "blocks": [
        { "type": "tab", "settings": { "title": "New arrivals" } },
        { "type": "tab", "settings": { "title": "Bestsellers" } },
        { "type": "tab", "settings": { "title": "Gifts" } }
      ]
    }
  ]
}
{% endschema %}
