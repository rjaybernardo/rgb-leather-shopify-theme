{%- assign s = section.settings -%}
<div class="section color-{{ s.color_scheme }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;">
  <div class="page-width">
    <div class="iwt{% if s.layout == 'right' %} iwt--reverse{% endif %}" style="--split: {% if s.image_width == 'large' %}1.3fr 1fr{% elsif s.image_width == 'small' %}1fr 1.3fr{% else %}1fr 1fr{% endif %}; --ratio: {% case s.image_ratio %}{% when 'square' %}1{% when 'landscape' %}4/3{% when 'tall' %}2/3{% else %}4/5{% endcase %};">
      <div class="iwt__media reveal">
        <div class="media hover-zoom">
          {%- if s.image -%}
            {{ s.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200,1600', sizes: '(min-width: 750px) 50vw, 100vw', alt: s.image.alt }}
          {%- else -%}
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if s.image_2 -%}
          <div class="iwt__media-secondary">
            <div class="media">{{ s.image_2 | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', sizes: '25vw', alt: s.image_2.alt }}</div>
          </div>
        {%- endif -%}
      </div>
      <div class="iwt__content reveal" style="--i: 1;">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'subheading' -%}
              <span class="subheading" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
            {%- when 'heading' -%}
              <h2 class="h2 heading-italic" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
            {%- when 'text' -%}
              <div class="iwt__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'checklist' -%}
              <ul class="check-list" {{ block.shopify_attributes }}>
                {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for item in items -%}
                  {%- assign line = item | strip -%}
                  {%- if line != blank -%}<li>{% render 'icon', icon: 'check' %}<span>{{ line }}</span></li>{%- endif -%}
                {%- endfor -%}
              </ul>
            {%- when 'stats' -%}
              <div class="iwt__stats" {{ block.shopify_attributes }}>
                {%- for i in (1..3) -%}
                  {%- assign vk = 'value_' | append: i -%}
                  {%- assign lk = 'label_' | append: i -%}
                  {%- if block.settings[vk] != blank -%}
                    <div><div class="iwt__stat-value">{{ block.settings[vk] }}</div><div class="iwt__stat-label">{{ block.settings[lk] }}</div></div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- when 'button' -%}
              <div class="button-row" {{ block.shopify_attributes }}>
                {%- if block.settings.label != blank -%}<a href="{{ block.settings.link }}" class="btn">{{ block.settings.label }}</a>{%- endif -%}
                {%- if block.settings.label_2 != blank -%}<a href="{{ block.settings.link_2 }}" class="btn btn--secondary">{{ block.settings.label_2 }}</a>{%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_2", "label": "Overlapping detail image" },
    { "type": "select", "id": "layout", "label": "Image position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "select", "id": "image_width", "label": "Image width", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ], "default": "medium" },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [ { "value": "portrait", "label": "Portrait" }, { "value": "tall", "label": "Tall" }, { "value": "square", "label": "Square" }, { "value": "landscape", "label": "Landscape" } ], "default": "portrait" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "subheading", "name": "Subheading", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Our craft" } ] },
    { "type": "heading", "name": "Heading", "limit": 1, "settings": [ { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Slow-made in our <em>own</em> workshop" } ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We source full-grain hides from family-run tanneries and finish each piece by hand. No shortcuts, no corrected grain — just honest leather that develops a rich patina over time.</p>" } ] },
    { "type": "checklist", "name": "Checklist", "settings": [ { "type": "textarea", "id": "items", "label": "Items (one per line)", "default": "Vegetable-tanned full-grain leather\nWaxed linen saddle stitching\nSolid brass hardware" } ] },
    {
      "type": "stats",
      "name": "Stats",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "value_1", "label": "Value 1", "default": "12+" },
        { "type": "text", "id": "label_1", "label": "Label 1", "default": "Years crafting" },
        { "type": "text", "id": "value_2", "label": "Value 2", "default": "40k" },
        { "type": "text", "id": "label_2", "label": "Label 2", "default": "Happy customers" },
        { "type": "text", "id": "value_3", "label": "Value 3", "default": "4.9★" },
        { "type": "text", "id": "label_3", "label": "Label 3", "default": "Average rating" }
      ]
    },
    {
      "type": "button",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "Our story" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "text", "id": "label_2", "label": "Second button label" },
        { "type": "url", "id": "link_2", "label": "Second button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        { "type": "subheading" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "stats" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
