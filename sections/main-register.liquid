<div class="section color-{{ section.settings.color_scheme }}" style="--pt: 64px; --pb: 96px;">
  <div class="page-width">
    <div class="account">
      <h1 class="h2 heading-italic text-center">{{ 'customer.register.title' | t }}</h1>
      {%- form 'create_customer', novalidate: 'novalidate' -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="form-grid form-grid--2">
          <div class="field"><label for="RegFirst">{{ 'customer.register.first_name' | t }}</label><input type="text" id="RegFirst" name="customer[first_name]" autocomplete="given-name"></div>
          <div class="field"><label for="RegLast">{{ 'customer.register.last_name' | t }}</label><input type="text" id="RegLast" name="customer[last_name]" autocomplete="family-name"></div>
        </div>
        <div class="field"><label for="RegEmail">{{ 'customer.login.email' | t }}</label><input type="email" id="RegEmail" name="customer[email]" autocomplete="email" required></div>
        <div class="field"><label for="RegPassword">{{ 'customer.login.password' | t }}</label><input type="password" id="RegPassword" name="customer[password]" autocomplete="new-password" required></div>
        <label class="checkbox" style="margin-bottom: 1.25rem;"><input type="checkbox" name="customer[accepts_marketing]" value="true" checked><span>{{ 'customer.register.marketing' | t }}</span></label>
        <button type="submit" class="btn btn--full">{{ 'customer.register.submit' | t }}</button>
      {%- endform -%}
      <p class="text-center text-muted" style="margin-top: 1.5rem;"><a href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a></p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer register",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
