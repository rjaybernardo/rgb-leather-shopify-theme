{%- assign s = section.settings -%}
<div class="section color-{{ s.color_scheme }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;">
  <div class="page-width">
    <h1 class="h1 heading-italic text-center">{{ blog.title }}</h1>
    {%- if blog.all_tags.size > 0 -%}
      <nav class="blog-tags" aria-label="{{ 'blogs.article.tags' | t }}">
        <a href="{{ blog.url }}" class="pill"{% unless current_tags %} aria-current="page"{% endunless %}>{{ 'blogs.article.all' | t }}</a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="pill"{% if current_tags contains tag %} aria-current="page"{% endif %}>{{ tag }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
    {%- paginate blog.articles by 9 -%}
      {%- if s.feature_first and paginate.current_page == 1 -%}
        {%- for article in blog.articles limit: 1 -%}
          <div style="margin-bottom: 3rem;" class="reveal">{% render 'article-card', article: article, featured: true, show_excerpt: true %}</div>
        {%- endfor -%}
      {%- endif -%}
      <ul class="grid" role="list" style="--cols: 3; --cols-mobile: 1; --cols-tablet: 2; list-style: none; padding: 0; margin: 0;">
        {%- for article in blog.articles -%}
          {%- if forloop.first and paginate.current_page == 1 and s.feature_first -%}{%- continue -%}{%- endif -%}
          <li class="reveal" style="--i: {{ forloop.index0 | modulo: 3 }};">{% render 'article-card', article: article, show_excerpt: true %}</li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "feature_first", "label": "Feature the latest post", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
