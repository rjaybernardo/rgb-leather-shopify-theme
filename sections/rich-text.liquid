{%- assign s = section.settings -%}
<div class="section color-{{ s.color_scheme }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;">
  <div class="page-width">
    <div class="rich-text reveal" style="--rt-w: {{ s.width }}px; --rt-align: {% if s.align == 'left' %}flex-start{% else %}center{% endif %}; --rt-text: {{ s.align }};">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'subheading' -%}
            <span class="subheading" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- when 'heading' -%}
            <h2 class="{{ block.settings.size }} heading-italic" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'text' -%}
            <div class="rich-text__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            <div class="button-row" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}<a href="{{ block.settings.link }}" class="btn">{{ block.settings.label }}</a>{%- endif -%}
              {%- if block.settings.label_2 != blank -%}<a href="{{ block.settings.link_2 }}" class="btn btn--secondary">{{ block.settings.label_2 }}</a>{%- endif -%}
            </div>
          {%- when 'signature' -%}
            <div class="rich-text__sig" {{ block.shopify_attributes }}>
              {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: block.settings.caption }}{%- endif -%}
              {%- if block.settings.caption != blank -%}<p class="text-muted" style="font-size: .85rem; margin-top: .5rem;">{{ block.settings.caption }}</p>{%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "select", "id": "align", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "center" },
    { "type": "range", "id": "width", "label": "Max width", "min": 400, "max": 1200, "step": 20, "unit": "px", "default": 820 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "subheading", "name": "Subheading", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Our promise" } ] },
    { "type": "heading", "name": "Heading", "settings": [ { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "We make fewer things, <em>better</em>" }, { "type": "select", "id": "size", "label": "Size", "options": [ { "value": "h1", "label": "Large" }, { "value": "h2", "label": "Medium" }, { "value": "h3", "label": "Small" } ], "default": "h1" } ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every product is designed to be used daily for decades, repaired rather than replaced, and loved a little more each year.</p>" } ] },
    { "type": "button", "name": "Buttons", "settings": [ { "type": "text", "id": "label", "label": "Button label", "default": "Read our story" }, { "type": "url", "id": "link", "label": "Link" }, { "type": "text", "id": "label_2", "label": "Second button label" }, { "type": "url", "id": "link_2", "label": "Second link" } ] },
    { "type": "signature", "name": "Signature", "settings": [ { "type": "image_picker", "id": "image", "label": "Signature image" }, { "type": "text", "id": "caption", "label": "Caption", "default": "Founder & head craftsman" } ] }
  ],
  "presets": [
    { "name": "Rich text", "blocks": [ { "type": "subheading" }, { "type": "heading" }, { "type": "text" }, { "type": "button" } ] }
  ]
}
{% endschema %}
