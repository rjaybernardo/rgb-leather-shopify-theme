{%- assign s = section.settings -%}
<div class="section color-{{ s.color_scheme }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;">
  <div class="page-width">
    <h1 class="h1 heading-italic text-center" style="margin-bottom: 2.5rem;">{{ s.heading }}</h1>
    <ul class="grid" role="list" style="--cols: {{ s.columns }}; list-style: none; padding: 0; margin: 0;">
      {%- for c in collections -%}
        {%- assign img = c.featured_image | default: c.products.first.featured_media.preview_image -%}
        <li class="reveal" style="--i: {{ forloop.index0 | modulo: 4 }};">
          <a href="{{ c.url }}" class="collection-tile collection-tile--overlay hover-zoom">
            <div class="media media--tall">
              {%- if img -%}{{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: '(min-width: 990px) 25vw, 50vw', alt: c.title }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
            </div>
            <span class="collection-tile__title"><span>{{ c.title }} <span class="collection-tile__count" style="color: inherit; opacity: .75;">{{ c.products_count }}</span></span>{% render 'icon', icon: 'arrow-right' %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collections list page",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
