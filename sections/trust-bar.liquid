<div class="section color-{{ section.settings.color_scheme }} trust-bar{% if section.settings.center %} trust-bar--center{% endif %} trust-bar--scroll" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <ul class="trust-bar__list" role="list" style="--count: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        <li class="trust-bar__item reveal" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <span class="trust-bar__icon">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {% render 'icon', icon: block.settings.icon %}
            {%- endif -%}
          </span>
          <div>
            <p class="trust-bar__title">{{ block.settings.title }}</p>
            {%- if block.settings.text != blank -%}<p class="trust-bar__text">{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "checkbox", "id": "center", "label": "Stack and center", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Badge",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Returns" },
            { "value": "shield", "label": "Shield" },
            { "value": "lock", "label": "Lock" },
            { "value": "hand", "label": "Handmade" },
            { "value": "leather", "label": "Leather" },
            { "value": "gift", "label": "Gift" },
            { "value": "award", "label": "Award" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "chat", "label": "Chat" },
            { "value": "globe", "label": "Globe" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "truck"
        },
        { "type": "image_picker", "id": "image", "label": "Custom icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On orders over $150" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Free shipping", "text": "On orders over $150" } },
        { "type": "item", "settings": { "icon": "return", "title": "30-day returns", "text": "Hassle-free exchanges" } },
        { "type": "item", "settings": { "icon": "shield", "title": "Lifetime warranty", "text": "On every stitch" } },
        { "type": "item", "settings": { "icon": "hand", "title": "Handmade", "text": "By a single artisan" } }
      ]
    }
  ]
}
{% endschema %}
